    {
      "id": 7,
      "type": "timeseries",
      "title": "Queued jobs by runner",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
