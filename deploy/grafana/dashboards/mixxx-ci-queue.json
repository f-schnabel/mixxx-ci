        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(mixxx_ci_jobs{runner=\"macOS\",status=\"queued\"})",
